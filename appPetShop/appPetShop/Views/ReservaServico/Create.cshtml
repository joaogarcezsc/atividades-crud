@model appPetShop.Models.ReservaServico

@{
    ViewData["Title"] = "Nova Reserva";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border">
            <div class="card-header bg-black text-white py-3">
                <h5 class="card-title mb-0 text-uppercase tracking-wide">Agendar Serviço</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label class="form-label fw-medium small text-uppercase">Cliente Logado</label>
                        <input class="form-control" value="@User.Identity?.Name" readonly disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="VeterinarioId" class="form-label fw-medium small text-uppercase">Veterinário</label>
                        <select asp-for="VeterinarioId" class="form-select" asp-items="ViewBag.VeterinarioId"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataHora" class="form-label fw-medium small text-uppercase">Data e Hora</label>
                        <input asp-for="DataHora" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="DataHora" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Valor" class="form-label fw-medium small text-uppercase">Valor (R$)</label>
                        <input asp-for="Valor" class="form-control" type="number" step="0.01" required />
                        <span asp-validation-for="Valor" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                        <button type="submit" class="btn btn-primary">Confirmar Agendamento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}